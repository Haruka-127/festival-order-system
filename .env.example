# サーバーのポート番号
PORT=3000

# Docker公開ポートのバインド先
BIND_ADDRESS=0.0.0.0

# サーバーのバインドアドレス
HOST=0.0.0.0

# SQLiteデータベースの保存先ディレクトリ
DATA_DIR=./data

# QRコードに埋め込むURLのベース
# リバースプロキシ使用時は必ず公開URLに設定すること
BASE_URL=https://festival.example.com

# 初期管理者ユーザー名（初回起動時にのみ反映）
ADMIN_USERNAME=admin

# 初期管理者パスワード（初回起動時にのみ反映）
ADMIN_PASSWORD=replace-with-a-long-random-password

# 受付番号の桁数（例: 3 → 001）
DISPLAY_NUMBER_DIGITS=3

# 採番日・注文受付時間の判定に使うIANAタイムゾーン
APP_TIME_ZONE=Asia/Tokyo

# 管理画面で作成するDBバックアップの最大保持数
BACKUP_RETENTION_COUNT=20

# production でSecure Cookie有効
NODE_ENV=production

# CookieのSecure属性を明示設定する場合に指定
# HTTPS配下ではtrue、HTTP直アクセスではfalse
# 未指定時は NODE_ENV=production の場合にtrue
COOKIE_SECURE=true

# 信頼できるリバースプロキシだけがアプリへ接続できる場合に有効化
TRUST_PROXY=false

# TLSを利用できない隔離された信頼済みLANでのみ、明示的に両方を変更
# COOKIE_SECURE=false
# ALLOW_INSECURE_HTTP=true
