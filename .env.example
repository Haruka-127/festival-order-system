# サーバーのポート番号
PORT=3000

# サーバーのバインドアドレス
HOST=0.0.0.0

# SQLiteデータベースの保存先ディレクトリ
DATA_DIR=./data

# QRコードに埋め込むURLのベース
# リバースプロキシ使用時は必ず公開URLに設定すること
BASE_URL=http://localhost:3000

# セッション管理用の秘密鍵（本番環境では必ず変更）
SESSION_SECRET=your-secure-secret-here

# 初期管理者ユーザー名（初回起動時にのみ反映）
ADMIN_USERNAME=admin

# 初期管理者パスワード（初回起動時にのみ反映）
ADMIN_PASSWORD=your-admin-password

# 受付番号の桁数（例: 3 → 001）
DISPLAY_NUMBER_DIGITS=3

# production でSecure Cookie有効
NODE_ENV=production

# CookieのSecure属性を明示設定する場合に指定
# HTTPS配下ではtrue、HTTP直アクセスではfalse
# 未指定時は NODE_ENV=production の場合にtrue
# COOKIE_SECURE=true
